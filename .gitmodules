[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "TrialSimulator"]
	path = TrialSimulator
	url = https://github.com/zhangh12/trialsimulator
[submodule "gim"]
	path = gim
	url = https://github.com/zhangh12/gim
[submodule "multipleOutcomes"]
	path = multipleOutcomes
	url = https://github.com/zhangh12/multipleoutcomes
[submodule "shinyStep"]
	path = shinyStep
	url = https://github.com/zhangh12/shinystep
